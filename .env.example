# ============ apps/server (NestJS) ============
# Neon / Vercel Postgres 连接串
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"
# 爬虫服务地址(services/crawler 部署后的 URL)
CRAWLER_BASE_URL="http://localhost:8000"
# server ↔ crawler 之间的共享密钥
CRAWLER_TOKEN="change-me-shared-secret"
# server 监听端口(本地)
PORT=3001

# ============ services/crawler (FastAPI) ============
# 与 server 一致的共享密钥
CRAWLER_TOKEN="change-me-shared-secret"
# Instagram 登录 cookie(运营自己的账号,规避未登录风控)。整段 cookie 头字符串。
IG_COOKIE=""
# Facebook 登录 cookie(整段 cookie 头,含 c_user/xs/datr 等)。抓 www 主页 + GraphQL 翻页需登录态。
# 注意:FB 对自动化 GraphQL 有较强风控,连发易软封;建议用可弃用的运营账号。
FB_COOKIE=""
# Scrapling 抓取模式:fetch(轻,TLS 指纹) | stealth(camoufox 浏览器,重)
SCRAPLING_MODE="fetch"

# ============ apps/web (umi) ============
# 前端访问的后端地址
UMI_APP_API_BASE="http://localhost:3001/api"
