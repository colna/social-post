{
  "name": "social-post",
  "version": "0.1.0",
  "private": true,
  "description": "可扩展的社媒帖子采集平台(首期 Instagram)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "web:dev": "pnpm --filter web dev",
    "web:build": "turbo run build --filter=web",
    "server:dev": "pnpm --filter server start:dev",
    "server:build": "turbo run build --filter=server",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
